<!DOCTYPE html>
<html>
<head>
<title>Calculator App - Running Edition 🏃‍♂️</title>
<style>
body { 
    font-family: Arial; 
    padding: 40px; 
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}
.container { 
    background:white; 
    padding:20px; 
    border-radius:10px; 
    width:320px; 
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}
input, button { 
    margin:5px; 
    padding:10px; 
    width:90%; 
    border-radius:5px;
    border:1px solid #ddd;
}
button {
    background:#667eea;
    color:white;
    cursor:pointer;
    transition:0.3s;
}
button:hover {
    background:#764ba2;
}
#running-tip {
    margin-top:15px;
    padding:10px;
    background:#f0f0f0;
    border-radius:5px;
    font-size:14px;
    color:#333;
}
</style>
</head>
<body>
<div class="container">
    <h2>🏃‍♂️ Runner's Calculator 🧮</h2>
    <p><small>¡Calcula mientras corres!</small></p>
    
    <!-- Campos para ingresar números -->
    <input id="a" type="number" placeholder="Primer número (ej: km recorridos)">
    <input id="b" type="number" placeholder="Segundo número (ej: minutos)">
    
    <!-- Botones de operaciones -->
    <button onclick="calculate('+')">➕ Sumar</button>
    <button onclick="calculate('-')">➖ Restar</button>
    <button onclick="calculate('*')">✖️ Multiplicar</button>
    <button onclick="calculate('/')">➗ Dividir</button>
    
    <!-- Resultado del cálculo -->
    <h3 id="result"></h3>
    
    <!-- Mensaje motivador sobre running -->
    <div id="running-tip">
        💡 <strong>Tip runner:</strong> ¡Haz clic en un botón y recibe motivación!
    </div>
</div>

<script>
// Función principal que realiza el cálculo y muestra mensajes de running
function calculate(op){
    // === OBTENER VALORES ===
    // parseFloat convierte el texto del input a número decimal
    let a = parseFloat(document.getElementById('a').value);
    let b = parseFloat(document.getElementById('b').value);
    let result = 0;
    let operationName = "";

    // === VALIDACIÓN: si algún valor no es número, mostrar error ===
    if(isNaN(a) || isNaN(b)){
        document.getElementById('result').innerHTML = "❌ Error: ¡Ingresa números válidos!";
        document.getElementById('running-tip').innerHTML = "🏃‍♂️ Tip: Antes de correr, asegúrate de tener bien tus números (km, tiempo, ritmo).";
        return; // sale de la función sin hacer el cálculo
    }

    // === REALIZAR CÁLCULO SEGÚN OPERACIÓN ===
    if(op === '+') {
        result = a + b;
        operationName = "suma";
    }
    if(op === '-') {
        result = a - b;
        operationName = "resta";
    }
    if(op === '*') {
        result = a * b;
        operationName = "multiplicación";
    }
    if(op === '/') {
        // Validar división entre cero
        if(b === 0) {
            document.getElementById('result').innerHTML = "🚫 Error: No se puede dividir por cero (¡ni correr sin zapatillas!)";
            document.getElementById('running-tip').innerHTML = "🏃‍♂️ Tip runner: Dividir por cero es como correr sin rumbo. ¡Revisa tus datos!";
            return;
        }
        result = a / b;
        operationName = "división";
    }

    // === MOSTRAR RESULTADO ===
    // Redondear a 2 decimales si es necesario
    let resultRedondeado = Math.round(result * 100) / 100;
    document.getElementById('result').innerHTML = "📊 Resultado: " + resultRedondeado + " (" + operationName + ")";

    // === MENSAJE ALEATORIO SOBRE RUNNING (11 opciones divertidas) ===
    const mensajesRunning = [
        "🏃‍♂️ ¡Como si hubieras corrido " + resultRedondeado + " km sin parar! 👟",
        "⏱️ Ese número equivale a " + Math.abs(resultRedondeado) + " minutos de trote ligero. ¡Sigue así!",
        "🔥 Quemas aproximadamente " + Math.abs(resultRedondeado * 8) + " calorías con ese esfuerzo.",
        "🎽 Si corres a 5 min/km, harías " + (resultRedondeado * 5).toFixed(1) + " minutos de ejercicio.",
        "💪 ¡Ese resultado tiene más fuerza que un sprinter olímpico!",
        "🏅 Ese número es la cantidad de vueltas a la pista que dio Eliud Kipchoge (mentira, pero suena bien).",
        "🌍 Si corres ese número de km, podrías cruzar 3 ciudades pequeñas.",
        "🦵 Cuidado: correr mucho sin estirar es como dividir por cero. ¡Estira siempre!",
        "☕ Número perfecto para tomarte " + Math.abs(resultRedondeado) + " cafés antes de un maratón.",
        "📈 Tu rendimiento running está en nivel " + Math.abs(resultRedondeado).toFixed(0) + " sobre 100. ¡A mejorar!",
        "🎧 Escucha música motivadora mientras procesas este cálculo: " + resultRedondeado
    ];
    
    // Seleccionar un mensaje al azar del array
    let indiceAleatorio = Math.floor(Math.random() * mensajesRunning.length);
    let mensajeElegido = mensajesRunning[indiceAleatorio];
    
    // Mostrar el mensaje en el div de running-tip
    document.getElementById('running-tip').innerHTML = "🏃‍♂️✨ " + mensajeElegido;
}

// === MENSAJE INICIAL DIVERTIDO (cuando carga la página) ===
window.onload = function() {
    console.log("🏁 Calculadora runner cargada. ¡A calcular kilómetros y tiempo!");
    document.getElementById('running-tip').innerHTML = "💪 ¡Bienvenido! Introduce dos números y haz clic en operación. Recibirás un tip runner + resultado.";
}
</script>
</body>
</html>
